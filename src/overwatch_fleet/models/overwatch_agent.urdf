    <joint name='left_wheel_joint' type='revolute'>
      <parent>base_link</parent>
      <child>left_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1.7976900000000001e+308</lower>
          <upper>1.7976900000000001e+308</upper>
        </limit>
